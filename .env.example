# Copie este arquivo para .env.local e preencha com os valores do seu projeto Firebase.
# Esses valores são públicos (vão junto com o site). Quem protege os dados são as regras do Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Só para testes locais com os emuladores. Nunca defina no site publicado.
# VITE_USAR_EMULADOR=sim
